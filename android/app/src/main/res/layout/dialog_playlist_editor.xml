<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_dark_bg"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvPlaylistEditorTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📋 Playlist: Minha Lista"
            android:textColor="#FFC107"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPlaylistEditorCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 filmes selecionados"
            android:textColor="#8899AA"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main Content: Left (Search + List) | Right (Action Sidebar) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Left Column: Search & Movies List -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Search Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <EditText
                    android:id="@+id/etPlaylistSearch"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/edit_text_dark_bg"
                    android:hint="Digite o nome do filme..."
                    android:textColor="#FFFFFF"
                    android:textColorHint="#6B7A90"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:imeOptions="actionSearch"
                    android:focusable="true"
                    android:focusableInTouchMode="true" />

                <TextView
                    android:id="@+id/btnPlaylistSearchAction"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/pill_focus_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="🔍 Buscar"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPlaylistListHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Filmes Disponíveis (Clique para adicionar/remover):"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:layout_marginBottom="4dp" />

            <!-- Movies List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPlaylistMovies"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:background="#0A0D15"
                android:padding="4dp" />
        </LinearLayout>

        <!-- Right Column: Sidebar Action Buttons -->
        <LinearLayout
            android:id="@+id/sidebarPlaylistActions"
            android:layout_width="190dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:orientation="vertical"
            android:gravity="top">

            <TextView
                android:id="@+id/btnSidebarNewSearch"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/pill_focus_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="🔍 Focar Busca"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSidebarCatalog"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/pill_focus_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="🌐 Todos os Filmes"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSidebarViewQueue"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/pill_focus_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="👁️ Ver Fila (0)"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:background="#202A3D" />

            <TextView
                android:id="@+id/btnSidebarSavePlaylist"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/pill_focus_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="💾 Salvar Playlist"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSidebarCancel"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="@drawable/pill_focus_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="❌ Cancelar"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
