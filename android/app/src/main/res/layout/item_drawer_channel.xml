<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerItemRoot"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/card_focus_bg"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <TextView
        android:id="@+id/drawerChNum"
        android:layout_width="38dp"
        android:layout_height="wrap_content"
        android:text="001"
        android:textColor="#FFC107"
        android:textSize="12sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/drawerChLogo"
        android:layout_width="36dp"
        android:layout_height="26dp"
        android:layout_marginStart="4dp"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/drawerChName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Globo SP"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/drawerChProgram"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Jornal Nacional"
            android:textColor="#FFC107"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/drawerLiveBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/badge_live"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:text="NO AR"
        android:textColor="#000000"
        android:textSize="9sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
