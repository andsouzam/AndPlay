<?xml version="1.0" encoding="utf-8"?>
<!--
  Sports Hub — Layout com sidebar lateral de ligas (modo gaveta/acordeão)
  Estrutura: [Sidebar 180dp | Divider | Content]
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080F1E"
    android:orientation="horizontal">

    <!-- ── SIDEBAR ESQUERDA: lista de ligas com sub-abas expansíveis ── -->
    <LinearLayout
        android:layout_width="180dp"
        android:layout_height="match_parent"
        android:background="#0C1428"
        android:orientation="vertical">

        <!-- Logo / Título sidebar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="#0A1020">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚽"
                android:textSize="18sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="8dp"
                android:text="JOGOS"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />
        </LinearLayout>

        <!-- Divider fino abaixo do título -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1AFFFFFF" />

        <!-- Lista de ligas (acordeão: liga + sub-abas TABELA/CALENDÁRIO) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/leagueTabsRv"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="6dp"
            android:paddingBottom="6dp" />

        <!-- Dica de tecla -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="10dp"
            android:text="VOLTAR: Fechar"
            android:textColor="#40FFFFFF"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- ── DIVIDER VERTICAL ───────────────────────────────────────────── -->
    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="#1AFFFFFF" />

    <!-- ── CONTEÚDO DIREITO ───────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Barra de contexto: nome da liga + guia ativa + dica -->
        <LinearLayout
            android:id="@+id/hubHeaderBar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="#0A1020"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Nome da liga ativa e guia -->
            <TextView
                android:id="@+id/hubLeagueName"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:textColor="#B0C8E8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <!-- Dica de navegação -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="◀ Voltar para Sidebar   ▲▼ Rolar"
                android:textColor="#55FFFFFF"
                android:textSize="10sp"
                android:background="#11FFFFFF" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1AFFFFFF" />

        <!-- Cabeçalho da Tabela (visível apenas na aba Tabela) -->
        <LinearLayout
            android:id="@+id/standingsHeaderRow"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:background="#0D1A30"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:visibility="gone">

            <TextView android:layout_width="26dp" android:layout_height="wrap_content"
                android:text="#" android:textColor="#66FFFFFF" android:textSize="10sp" android:gravity="center" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Clube" android:textColor="#66FFFFFF" android:textSize="10sp" />
            <TextView android:layout_width="30dp" android:layout_height="wrap_content"
                android:text="PTS" android:textColor="#FFD700" android:textSize="10sp" android:textStyle="bold" android:gravity="center" />
            <TextView android:layout_width="26dp" android:layout_height="wrap_content"
                android:text="PJ" android:textColor="#66FFFFFF" android:textSize="10sp" android:gravity="center" />
            <TextView android:layout_width="24dp" android:layout_height="wrap_content"
                android:text="V" android:textColor="#66FFFFFF" android:textSize="10sp" android:gravity="center" />
            <TextView android:layout_width="28dp" android:layout_height="wrap_content"
                android:text="SG" android:textColor="#66FFFFFF" android:textSize="10sp" android:gravity="center" />
            <TextView android:layout_width="24dp" android:layout_height="wrap_content"
                android:text="GP" android:textColor="#66FFFFFF" android:textSize="10sp" android:gravity="center" />
        </LinearLayout>

        <!-- Loading spinner -->
        <ProgressBar
            android:id="@+id/hubProgress"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="40dp"
            android:visibility="gone" />

        <!-- Mensagem sem dados -->
        <TextView
            android:id="@+id/hubEmptyMsg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="48dp"
            android:text="Sem dados disponíveis para esta liga"
            android:textColor="#50FFFFFF"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Conteúdo principal (calendário ou tabela) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/hubContentRv"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

    </LinearLayout>

</LinearLayout>
