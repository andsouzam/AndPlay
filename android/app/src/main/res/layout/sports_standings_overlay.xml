<?xml version="1.0" encoding="utf-8"?>
<!-- Overlay lateral acionado por D-pad Direito em tela cheia esportiva -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sportsStandingsOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <!-- Fundo escurecido (toque fecha o overlay) -->
    <View
        android:id="@+id/standingsDim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#88000000" />

    <!-- Painel lateral direito -->
    <LinearLayout
        android:id="@+id/standingsPanel"
        android:layout_width="380dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#E8080E1C"
        android:orientation="vertical"
        android:paddingStart="0dp"
        android:paddingEnd="0dp">

        <!-- Cabeçalho: liga + dica D-pad -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#CC0D1526"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/standingsLeagueIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚽"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/standingsLeagueName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Competição"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/standingsMatchScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="AO VIVO"
                    android:textColor="#4FC3F7"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#22FFFFFF"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="VOLTAR: Fechar"
                android:textColor="#B0FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Abas: Tabela / Rodada (navegáveis por D-pad Esquerdo e Direito) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="#CC060B14"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabStandings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="◀ TABELA"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="#991565C0"
                android:focusable="true"
                android:clickable="true" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#33FFFFFF" />

            <TextView
                android:id="@+id/tabRound"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="RODADA ▶"
                android:textColor="#80FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@null"
                android:focusable="true"
                android:clickable="true" />
        </LinearLayout>

        <!-- Loading indicator -->
        <ProgressBar
            android:id="@+id/standingsProgress"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:visibility="gone" />

        <!-- Mensagem de erro/vazio -->
        <TextView
            android:id="@+id/standingsEmptyMsg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:padding="16dp"
            android:text="Dados não disponíveis\npara esta competição."
            android:textColor="#80FFFFFF"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Painel TABELA DE CLASSIFICAÇÃO -->
        <LinearLayout
            android:id="@+id/standingsTablePanel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Cabeçalho da tabela -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:background="#CC060B14"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="#"
                    android:textColor="#80FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="CLUBE"
                    android:textColor="#80FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="24dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="PJ"
                    android:textColor="#80FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="PTS"
                    android:textColor="#FFD700"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="24dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="SG"
                    android:textColor="#80FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="24dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="GF"
                    android:textColor="#80FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#22FFFFFF" />

            <!-- Lista de classificação -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/standingsRecycler"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="8dp" />
        </LinearLayout>

        <!-- Painel JOGOS DA RODADA -->
        <LinearLayout
            android:id="@+id/roundMatchesPanel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/roundTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#CC060B14"
                android:gravity="center"
                android:padding="8dp"
                android:text="JOGOS DA RODADA"
                android:textColor="#80FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#22FFFFFF" />

            <!-- Lista dos jogos -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/roundMatchesRecycler"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="8dp" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
