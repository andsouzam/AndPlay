<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/movieCardRoot"
    android:layout_width="112dp"
    android:layout_height="160dp"
    android:layout_margin="4dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="3dp"
    app:cardPreventCornerOverlap="false"
    app:cardUseCompatPadding="false"
    app:cardBackgroundColor="#0C101B"
    android:foreground="@drawable/card_focus_fg"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <ImageView
        android:id="@+id/moviePoster"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <!-- Barra translúcida sobreposta ao rodapé da capa com cantos arredondados -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/card_bottom_gradient"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="16dp"
        android:paddingBottom="5dp">

        <TextView
            android:id="@+id/movieTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Título do Filme"
            android:textColor="#FFFFFF"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/movieSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="2024 ★ 8.5"
            android:textColor="#FFC107"
            android:textSize="9.5sp" />
    </LinearLayout>

    <!-- Barra de Progresso Real (Onde parou) -->
    <ProgressBar
        android:id="@+id/movieProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3.5dp"
        android:layout_gravity="bottom"
        android:max="100"
        android:progress="0"
        android:visibility="gone" />

    <!-- Badge de Favorito Salvo -->
    <TextView
        android:id="@+id/movieFavBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="4dp"
        android:background="@drawable/badge_pill_dark"
        android:paddingStart="5dp"
        android:paddingTop="1.5dp"
        android:paddingEnd="5dp"
        android:paddingBottom="1.5dp"
        android:text="★"
        android:textColor="#FFC107"
        android:textSize="9sp"
        android:visibility="gone" />

    <!-- Badge de Versões Disponíveis (ex: 4K • DUB, DUB • LEG) -->
    <TextView
        android:id="@+id/movieVersionBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/badge_pill_dark"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:text="4K • DUB"
        android:textColor="#38BDF8"
        android:textSize="7.5sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Badge de Tipo (Filme ou Série, estilo Web) -->
    <TextView
        android:id="@+id/movieTypeBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="4dp"
        android:background="@drawable/badge_pill_dark"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:text="FILME"
        android:textColor="#38BDF8"
        android:textSize="8sp"
        android:textStyle="bold"
        android:visibility="gone" />
</androidx.cardview.widget.CardView>
