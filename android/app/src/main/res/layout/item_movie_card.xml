<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/movieCardRoot"
    android:layout_width="110dp"
    android:layout_height="150dp"
    android:layout_margin="3dp"
    android:background="#0C101B"
    android:foreground="@drawable/card_focus_fg"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <ImageView
        android:id="@+id/moviePoster"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter" />

    <!-- Barra translúcida sobreposta ao rodapé da capa -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/card_bottom_gradient"
        android:orientation="vertical"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/movieTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Título do Filme"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/movieSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="2024 ★ 8.5"
            android:textColor="#FFC107"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- Barra de Progresso Real (Onde parou) -->
    <ProgressBar
        android:id="@+id/movieProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_gravity="bottom"
        android:max="100"
        android:progress="0"
        android:visibility="gone" />

    <!-- Badge de Favorito Salvo -->
    <TextView
        android:id="@+id/movieFavBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="3dp"
        android:background="#B3000000"
        android:paddingStart="4dp"
        android:paddingTop="1dp"
        android:paddingEnd="4dp"
        android:paddingBottom="1dp"
        android:text="★"
        android:textColor="#FFC107"
        android:textSize="10sp"
        android:visibility="gone" />

    <!-- Badge de Tipo (Filme ou Série, estilo Web) -->
    <TextView
        android:id="@+id/movieTypeBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="3dp"
        android:background="#D9000000"
        android:paddingStart="5dp"
        android:paddingTop="1.5dp"
        android:paddingEnd="5dp"
        android:paddingBottom="1.5dp"
        android:text="FILME"
        android:textColor="#38BDF8"
        android:textSize="8sp"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
