<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Estado focado: Ouro radiante com borda branca elegante -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient
                android:startColor="#FDE047"
                android:endColor="#F59E0B"
                android:angle="45" />
            <stroke android:width="2.5dp" android:color="#FFFFFF" />
        </shape>
    </item>
    <!-- Estado pressionado -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#D97706" />
        </shape>
    </item>
    <!-- Estado normal: Ouro rico elegante com cantos suaves -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient
                android:startColor="#F59E0B"
                android:endColor="#D97706"
                android:angle="45" />
            <stroke android:width="1dp" android:color="#FDE047" />
        </shape>
    </item>
</selector>
