<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focado pelo controle: borda âmbar forte (#FFC107) com fundo escuro, igual aos cards da tela inicial -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#1A2035" />
            <stroke android:width="2.5dp" android:color="#FFC107" />
        </shape>
    </item>
    <!-- Selecionado (liga ativa): borda âmbar refinada e fundo escuro -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#162033" />
            <stroke android:width="1.5dp" android:color="#D4A017" />
        </shape>
    </item>
    <!-- Padrão inativo -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
