<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Estado focado na TV: Borda branca brilhante e fundo iluminado -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#24344E" />
            <stroke android:width="2.5dp" android:color="#FFFFFF" />
        </shape>
    </item>
    <!-- Estado pressionado / ativo -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#1A273D" />
            <stroke android:width="1.5dp" android:color="#FFC107" />
        </shape>
    </item>
    <!-- Estado normal: Card escuro elegante translúcido -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#121824" />
            <stroke android:width="1dp" android:color="#223044" />
        </shape>
    </item>
</selector>
